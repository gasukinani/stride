<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- App Configuration -->
    <ApplicationTitle>Stride Mobile Studio</ApplicationTitle>
    <ApplicationId>com.gasukinani.stridestudio</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Android Packaging Settings -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidUseIntermediateDesignerFile>True</AndroidUseIntermediateDesignerFile>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>

    <!-- Roslyn Runtime Compilation Support -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>

    <!-- Stride Engine Environment (Dito ilagay para hindi maipasa sa host net10.0) -->
    <StridePlatform>Android</StridePlatform>
    <StrideGraphicsApi>OpenGLES</StrideGraphicsApi>
    <StrideGraphicsApis>OpenGLES</StrideGraphicsApis>
  </PropertyGroup>

  <!-- ======================================================== -->
  <!-- STRIDE CORE ENGINE SUBPROJECTS                           -->
  <!-- ======================================================== -->
  <ItemGroup>
    <ProjectReference Include="..\..\engine\Stride.Engine\Stride.Engine.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Physics\Stride.Physics.csproj" />
    <ProjectReference Include="..\..\engine\Stride.UI\Stride.UI.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Navigation\Stride.Navigation.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Particles\Stride.Particles.csproj" />
  </ItemGroup>

  <!-- ======================================================== -->
  <!-- RUNTIME C# SCRIPTING COMPILER (ROSLYN)                   -->
  <!-- ======================================================== -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.12.0" />
  </ItemGroup>

</Project>
