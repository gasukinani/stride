<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <AndroidApplication>True</AndroidApplication>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- App Identity -->
    <ApplicationTitle>Stride Mobile Studio</ApplicationTitle>
    <ApplicationId>com.gasukinani.stridestudio</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Kinukuha ang manifest sa labas -->
    <AndroidManifest>..\AndroidManifest.xml</AndroidManifest>

    <!-- Android Packaging Settings -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidUseIntermediateDesignerFile>True</AndroidUseIntermediateDesignerFile>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>

    <!-- Runtime Roslyn Scripting Protection -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>

    <!-- Stride Platform -->
    <StridePlatform>Android</StridePlatform>
    <StrideGraphicsApi>OpenGLES</StrideGraphicsApi>
    <StrideGraphicsApis>OpenGLES</StrideGraphicsApis>
  </PropertyGroup>

  <!-- ISINASAMA ANG LAHAT NG .CS AT MANIFEST SA LABAS -->
  <ItemGroup>
    <Compile Include="..\*.cs" />
    <None Include="..\AndroidManifest.xml" />
  </ItemGroup>

  <!-- STRIDE CORE ENGINE SUBPROJECTS -->
  <ItemGroup>
    <ProjectReference Include="..\..\engine\Stride.Engine\Stride.Engine.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Games\Stride.Games.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Physics\Stride.Physics.csproj" />
    <ProjectReference Include="..\..\engine\Stride.UI\Stride.UI.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Navigation\Stride.Navigation.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Particles\Stride.Particles.csproj" />
  </ItemGroup>

  <!-- RUNTIME ROSLYN COMPILER -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.12.0" />
  </ItemGroup>

</Project>
