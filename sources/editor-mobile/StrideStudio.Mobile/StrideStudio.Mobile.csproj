<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    
    <!-- Kritikal: Tinitiyak na bubuo ito ng buong Android Application Package -->
    <AndroidApplication>True</AndroidApplication>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- App Identity & Manifest Link -->
    <ApplicationTitle>Stride Mobile Studio</ApplicationTitle>
    <ApplicationId>com.gasukinani.stridestudio</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>

    <!-- Android Packaging Settings -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidUseIntermediateDesignerFile>True</AndroidUseIntermediateDesignerFile>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>

    <!-- Runtime Roslyn Scripting Protection (Bawal i-strip ang compiler APIs sa release) -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>

    <!-- Stride Engine Environment Settings -->
    <StridePlatform>Android</StridePlatform>
    <StrideGraphicsApi>OpenGLES</StrideGraphicsApi>
    <StrideGraphicsApis>OpenGLES</StrideGraphicsApis>
  </PropertyGroup>

  <!-- ======================================================== -->
  <!-- STRIDE CORE ENGINE SUBPROJECTS                           -->
  <!-- ======================================================== -->
  <ItemGroup>
    <ProjectReference Include="..\..\engine\Stride.Engine\Stride.Engine.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Physics\Stride.Physics.csproj" />
    <ProjectReference Include="..\..\engine\Stride.UI\Stride.UI.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Navigation\Stride.Navigation.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Particles\Stride.Particles.csproj" />
  </ItemGroup>

  <!-- ======================================================== -->
  <!-- RUNTIME C# SCRIPTING COMPILER (ROSLYN)                   -->
  <!-- ======================================================== -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.12.0" />
  </ItemGroup>

  <!-- ======================================================== -->
  <!-- ANDROID MANIFEST FILE LINK                               -->
  <!-- ======================================================== -->
  <ItemGroup Condition="Exists('Properties\AndroidManifest.xml')">
    <None Include="Properties\AndroidManifest.xml" />
  </ItemGroup>

</Project>
