<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ITUGMA SA STRIDE ENGINE: net10.0-android imbes na net8.0 -->
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- App Configuration -->
    <ApplicationTitle>Stride Mobile Studio</ApplicationTitle>
    <ApplicationId>com.gasukinani.stridestudio</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidUseIntermediateDesignerFile>True</AndroidUseIntermediateDesignerFile>

    <!-- Stride Engine Environment -->
    <StridePlatform>Android</StridePlatform>
    <StrideGraphicsApi Condition="'$(StrideGraphicsApi)' == ''">OpenGLES</StrideGraphicsApi>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>
  </PropertyGroup>

  <!-- ======================================================== -->
  <!-- STRIDE CORE ENGINE SUBPROJECTS (PROJECT REFERENCES)      -->
  <!-- ======================================================== -->
  <ItemGroup>
    <ProjectReference Include="..\..\engine\Stride.Engine\Stride.Engine.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Physics\Stride.Physics.csproj" />
    <ProjectReference Include="..\..\engine\Stride.UI\Stride.UI.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Navigation\Stride.Navigation.csproj" />
    <ProjectReference Include="..\..\engine\Stride.Particles\Stride.Particles.csproj" />
  </ItemGroup>

  <!-- ======================================================== -->
  <!-- RUNTIME C# SCRIPTING COMPILER (GUMAGAMIT NG VersionOverride PARA SA CPM) -->
  <!-- ======================================================== -->
  <ItemGroup>
    <!-- VersionOverride ang tamang paraan sa CPM para hindi masira ang ibang projects -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.8.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Properties\AndroidManifest.xml" Condition="Exists('Properties\AndroidManifest.xml')" />
  </ItemGroup>

</Project>
