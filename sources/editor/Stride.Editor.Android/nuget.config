<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Burahin ang local source restrictions -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- Burahin ang PackageSourceMapping para malayang mag-download mula nuget.org -->
    <clear />
  </packageSourceMapping>
</configuration>
